{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd REACTMOD && npm ci",
  "buildCommand": "cd REACTMOD && npm run build",
  "outputDirectory": "REACTMOD/dist",
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/login.html", "destination": "/login", "permanent": true },
    { "source": "/signup.html", "destination": "/signup", "permanent": true },
    { "source": "/patient-dashboard.html", "destination": "/patient", "permanent": true },
    { "source": "/professional-dashboard.html", "destination": "/pro", "permanent": true },
    { "source": "/admin-dashboard.html", "destination": "/admin", "permanent": true },
    { "source": "/admin-users.html", "destination": "/admin/users", "permanent": true },
    { "source": "/admin-analytics.html", "destination": "/admin/analytics", "permanent": true },
    { "source": "/admin-diagnostics.html", "destination": "/admin/diagnostics", "permanent": true },
    { "source": "/admin-content.html", "destination": "/admin/content", "permanent": true },
    { "source": "/admin-settings.html", "destination": "/admin/settings", "permanent": true }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
